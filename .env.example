# StepDaddyLiveHD Mobile (Termux) — Environment Template
# Copy this to .env.termux and edit as needed.

PORT=3000
API_URL=http://127.0.0.1:3000
PROXY_CONTENT=FALSE
SOCKS5=
REDIS_URL=redis://127.0.0.1:6379

# EPG sources (comma-separated URLs)
EPG_URLS=https://iptv-epg.org/files/epg-us.xml.gz,https://epg.pw/xmltv/epg.xml.gz,https://epgshare01.online/epgshare01/epg_ripper_ALL_SOURCES1.xml.gz
EPG_REFRESH_SECONDS=86400
EPG_ENABLE_FUZZY=TRUE
EPG_ENABLE_HEAVY_FALLBACK=TRUE
EPG_HEAVY_MIN_CHANNELS_WITH_PROGRAMMES=300
EPG_HEAVY_COOLDOWN_SECONDS=21600
EPG_DOWNLOAD_TIMEOUT_SECONDS=45
EPG_HEAVY_MAX_MB=60
EPG_MIN_FREE_MEM_MB=300

# Share links (optional — set to your public URL if using Cloudflare tunnel)
# SHARE_SECRET=change-me-now
# SHARE_BASE_URL=https://your-tunnel.trycloudflare.com

# PIN auth (hashed pins in config/pins.json)
# PIN_AUTH_ENABLED=1
# PIN_CONFIG=config/pins.json
# PIN_SESSION_TTL=2592000

# Gapless no-PIN guest grace (soft entry, then stream lock)
# PIN_GUEST_ENABLED=1
# PIN_GUEST_GRACE_SECONDS=900
# PIN_GUEST_REMINDER_FIRST_SECONDS=300
# PIN_GUEST_REMINDER_SECONDS=180
# PIN_GUEST_LOCKOUT_SECONDS=900
# PIN_GUEST_ABUSE_MAX=8
# PIN_GUEST_ABUSE_WINDOW_SECONDS=600
# PIN_GUEST_SECRET=  # optional; falls back to SHARE_SECRET

# Watch party catchup / timeshift (optional live sync)
# Prefer OPENCLAW disk on VPS, e.g. /home/nova/openclaw/catchup-cache
# PARTY_CATCHUP_DIR=/path/to/catchup-cache
# PARTY_CATCHUP_WINDOW_SEC=300
# PARTY_CATCHUP_MAX_SESSIONS=2
# PARTY_CATCHUP_INTERNAL_KEY=sd-catchup-local
# FFMPEG_BIN=/usr/bin/ffmpeg

# Watchdog tuning
WATCHDOG_INTERVAL=20
WATCHDOG_FAIL_THRESHOLD=4
WATCHDOG_STARTUP_GRACE=180
WATCHDOG_RESTART_COOLDOWN=300

# Live sources — DaddyLive ON (CDN thrash guards + gray-out if workers.dev ToS-blocked)
USE_DADDYLIVE=1
# EPG — keep EPG_DISABLE=TRUE on low-RAM hosts to skip heavy XMLTV; WhatsOnFreeTV
# Free-TV + FAST (Pluto/Plex/Roku/Samsung/Tubi/Xumo) programmes still load when
# WOFTV_EPG_ENABLE=1 (lite mode). Secondary XMLTV (not fetched in lite):
#   i.mjh.nz Pluto/Plex/Samsung/Roku gzip guides; BuddyChewChew tubi_epg.xml
# WOFTV_EPG_ENABLE=1
# WOFTV_EPG_CACHE_TTL_SEC=21600
# WOFTV_EPG_COUNTRIES=us,ca
#
# epg.pw — selective DDL gap-fill by confirmed region (NEVER full world dumps)
# EPGPW_ENABLE=1
# EPGPW_CHANNEL_MAP=486840:360
# EPGPW_CHANNEL_MAP_FILE=assets/epgpw_channel_map.json
# EPGPW_CACHE_TTL_SEC=1200
# EPGPW_TZ=UTC
# EPGPW_DAYS=2
# EPGPW_AUTO_MATCH=1
# EPGPW_AUTO_MAX=24
# EPGPW_AUTO_MAX_PER_REGION=16
# EPGPW_INDEX_COUNTRIES=GB
# EPGPW_ALLOW_US_INDEX=0
# EPGPW_REGION_GZ_PROGRAMMES=1
# EPGPW_FETCH_CONCURRENCY=2
# EPGPW_AUTO_SPORTS=0

SUPPLEMENT_FREETV=1
SUPPLEMENT_IPTV_ORG=1
SUPPLEMENT_ADULT_SWIM=1
SUPPLEMENT_DULO=1
SUPPLEMENT_NTV=1
# Optional JWT for dulo.cx Live TV playback (catalog works without it)
# DULO_CX_ACCESS_TOKEN=
